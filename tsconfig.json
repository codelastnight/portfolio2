{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "$public": [
        "public/*"
      ],
      "$content": [
        "content/*"
      ],
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "@rollup/plugin-yaml"
    ],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}