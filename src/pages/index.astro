---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

import MainHero from "../components/MainHero.astro";
import ImageRow from "../components/ImageRow.astro";
import { ViewTransitions } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE, ANCHORTAGS } from "../config";
import ShinyButton from "../components/ShinyButton.astro";
import pageConfig from './indexConfig.yml'
const { title } = SITE;
const description = "Simon Zhang is just practicing design";

interface PageConfig {
  funFacts: {
    [key: string]: {
      href: string
      text: string
    }
  }
}
const funFacts = (pageConfig as PageConfig).funFacts


// Data Fetching: List all Markdown posts in the repo.

const allPosts = (
  await getCollection("work", ({ data }) => {
    return data.archive !== true;
  })
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---
<head>
  <BaseHead {title} {description} />
  
</head>
<Layout>
  <div class="md:sticky top-12 page-margins z-[0] safari-fix-bottom ">
    <MainHero />
    <section class='flex flex-col items-center mt-[15vh] ' >
      
      <p class="text-center">
        Graphic designer and Web developer <a href="/after-hours">in the evening</a>
      </p>
    </section>
  </div>
  

  <section
    aria-label='Blog post list'
    class='flex flex-col items-center mt-12 safari-fix'
    id='work'
  >
    {allPosts?.map((post, index) => 
      <a href={`/work/${post.slug}`} class="group link-clear z-20"  >
    <article class='w-full page-margins py-12 bg-theme-light text-theme-dark' style=`--c-light: ${post.data.colors.bg}; --c-dark: ${post.data.colors.fg} `  >
      <header>
        <h1 class='text-center pb-4 '>
          <span class='block'>Case Study {index}:</span>
          <span class='block text-4xl md:text-5xl group-hover:underline' transition:name={"title:"+post.slug}>{post.data.title}</span>
        </h1>
      </header>
      <ImageRow images={post.data.heroImages}  slug={post.slug} class="" />
      <footer class='flex justify-between flex-col md:flex-row mt-2 gap-2 leading-tight'>
        <p class='text-sm md:text-base max-w-md flex-shrink'>{post.data.description}</p>
        <ShinyButton height="4em" width="13em" color={post.data.colors.fg} class='self-center min-w-[7em]'>
           <span class="text-theme-light text-center">View Full Case Study</span>
        </ShinyButton>
      </footer>
    </article>          
    </a>
)}
  </section>
  <section id="about" class='page-margins py-10 grid grid-cols-1 lg:grid-cols-2 bg-theme-light relative z-10 safari-fix'>
    <div class="lg:col-start-2">
      <p class='text-2xl md:text-3xl lg:text-4xl  max-w-2xl ' >
        <span class="inline-block indent-[3em]">simon zhang</span> is a cross-disciplinary designer based in ATL & SEA —
        <span id="funny-caption" class="">  
          netscape-oriented with a post-aero slant.</span> bachelor of science in industrial design from georgia tech. creating intimacy between
        physical and digital products. <span>    
          <button data-contact class="psuedo-link">lets connect <3</button>
        </span>
      </span>
     
      </p>
      <div class='grid grid-cols-2 gap-y-4 gap-x-3 mt-6 max-w-2xl'>
        {Object.entries(funFacts).map(([heading,data]) =>(
          <p  class="text-sm md:text-base">
          <span class="opacity-80">{heading} </span>
          <br/>
          <a href={data.href} target="_blank">{data.text}</a>
          </p>
        ))}
      
      
      </p>
    </div>
    
    </div>
    <script>

  import { gsap } from "gsap";
  import { MotionPathPlugin } from "gsap/MotionPathPlugin";


  //let mainTimeline = gsap.timeline({ paused: true });
  const trigger = ".animate-text-in2";
  let titleText = gsap.timeline();

  //mainTimeline.add(titleText);
  function gsapAnimation() {
    if (titleText.isActive()) return;

    //  if (mainTimeline.isActive()) return;
    titleText.from(trigger, {
      y: 50,

      duration: 0.7,
      ease: "power4.out",
      stagger: 0.1,
    });
    // mainTimeline.add(titleButtons);
    //mainTimeline.play();
    console.log("animation");
  }
  document.addEventListener("DOMContentLoaded", function (event) {
    // wait until window is loaded - all images, styles-sheets, fonts, links, and other media assets
    // you could also use addEventListener() instead

    window.addEventListener("load", (event) => {
      console.log("onload");
      // OPTIONAL - waits til next tick render to run code (prevents running in the middle of render tick)
      window.requestAnimationFrame(function () {
        // GSAP custom code goes here
        gsapAnimation();
      });
    });
  });



      const set1 = [
        'netscape',
        'proto-scholastic',
        'superflat',
        'degrowth',
        'soft gen-x',
        'blob world',
        'post-aero',
        'neo-bling',
        'vectorheart',
        'acidgraphix',
        'cyber pomo',
        'post post post modernism',
        'all-american suburbia',
        'bike path',
        'public transit',
        'diamond pickaxe',
        'default cube',
        'bevel tool',
        'content-aware fill',
        'pen tool',
        'strawberry matcha latte',
        'extrude face',
        'duplicate object',
        'public library',
        'digicore',
        'corner radius',
        'soft grid',
        'industrial glycine',
        'galvanized square metal',
        'frasurbane',
        'doodle-core',
        'PBR (peanut butter rendering)',
        'vocaloid'
      ]
  let shuffledCaptionList = shuffleArray(set1);
  const captionElement = document.getElementById(
    "funny-caption"
  ) as HTMLParagraphElement;

  let timeout;
  let count = 0;

  // shuffledCaptionList.forEach((caption) => {
  //   const span = document.createElement("span");
  //   span.innerText = caption;
  //   captionElement.appendChild(span);
  // });

  // new caption every some seconds
 const timer = 5000
  timeout = setTimeout(function tick() {
     if (count == 0) shuffledCaptionList = shuffleArray(set1);
     count = (count + 2) % shuffledCaptionList.length; // loop thru array
     const count1 = (count + 1) % shuffledCaptionList.length;
    //count = Math.floor(Math.random() * shuffledCaptionList.length);
    const text = `${shuffledCaptionList[count]} oriented with a${"aeiou".includes(shuffledCaptionList[count1][0]) ? 'n' : '' } ${shuffledCaptionList[count1]} slant.`
    captionElement.innerText = '';
    text.split(' ').forEach((word)=> {
      const spanouter = document.createElement("span");
      const span = document.createElement("span");
   
    spanouter.className = 'text-hide'
    span.innerText = word + " ";
    span.className = 'animate-text-in2'
    spanouter.appendChild(span)
    
    captionElement.appendChild(spanouter);
    captionElement.innerHTML += " ";
    })

      window.requestAnimationFrame(function () {
        // GSAP custom code goes here
        gsapAnimation();
      });
    timeout = setTimeout(tick, timer);
  }, timer);

  function shuffleArray(array: string[]) {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
  }
      </script>
  </section>
</Layout>

<style lang="postcss">
  .psuedo-link {
    @apply underline hover:bg-theme-dark hover:text-theme-light;
  }
  :global(.text-hide) {
      @apply inline-block overflow-hidden align-bottom;
    }
    :global(.animate-text-in2 ) {
      @apply inline-block;
    }
    .safari-fix {
      // on top
    transform: translate3d(0, 0, 100px);
}
    .safari-fix-bottom {
      transform: translate3d(0, 0, 0px);
    }

</style>