---
import type { CollectionEntry } from "astro:content";
import { getFirst } from "./helper";

interface Props {
  currentId: string;
  collection: string;
  postList: CollectionEntry<"work">[] | CollectionEntry<"play">[];
  class?: string;
}

const { collection, postList, currentId, class: classList = "" } = Astro.props;

const linkId = collection === "play" ? "after-hours" : collection;

function setColors(fg: string, bg: string) {
  return `--color-theme-light: ${bg}; --color-theme-dark: ${fg} `;
}
---

<footer class={`mt-8 grid grid-cols-2 md:grid-cols-3 ${classList}`}>
  {
    postList.map((post) =>
      post.id !== currentId ? (
        <a
          class="directory page-margins"
          href={`/${linkId}/${post.id}`}
          style={setColors(post.data.colors.fg, post.data.colors.bg)}
        >
          <h2 class="pb-2">{post.data.title}</h2>
          {getFirst(post.data.heroImages, (img) => (
            <img src={img[1].src} class="w-full aspect-square object-cover" />
          ))}
        </a>
      ) : (
        <div class="directory active page-margins items-center-safe">
          <h2>{post.data.title}</h2>
          <div class="flex-1 flex place-items-center">
            <p class="text-xl  flex w-fit md:text-xl border-2 border-theme-dark rounded-full px-3">
              You Are Here
            </p>
          </div>
        </div>
      )
    )
  }
</footer>
<style>
  @reference '@/global.css';

  .directory {
    @apply py-5 border-theme-dark flex flex-col leading-tight;
    @apply text-lg md:text-2xl text-center;
  }
  .directory.active {
    @apply border-2 border-dashed;
  }
</style>
